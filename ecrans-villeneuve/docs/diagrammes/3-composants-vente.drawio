        <mxCell id="cr_av" value="&lt;b&gt;ApplicationVente&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;assemble tout en Java pur&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;(utilisée par les tests)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;strokeWidth=1.5;fontSize=11;fontColor=#1e293b;align=center;verticalAlign=middle;shadow=1;" parent="1" vertex="1"><mxGeometry x="60" y="705" width="220" height="75" as="geometry"/></mxCell>
        <mxCell id="cr_vc" value="&lt;b&gt;VenteConfiguration&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;publie les ports en @Bean Spring&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;+ Clock + séance S42 de démo&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#b45309;&quot;&gt;&lt;b&gt;ajouté étape 7&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;strokeWidth=1.5;fontSize=11;fontColor=#1e293b;align=center;verticalAlign=middle;shadow=1;" parent="1" vertex="1"><mxGeometry x="310" y="705" width="220" height="80" as="geometry"/></mxCell>
        <mxCell id="e1" value="utilise" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;spacing=3;strokeColor=#64748b;fontColor=#1e293b;endArrow=open;endFill=0;dashed=1;" parent="1" source="cr_vc" target="cr_av" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="lecture" value="&lt;b&gt;Comment lire&lt;/b&gt;&lt;br&gt;• Les flèches de dépendance vont &lt;b&gt;vers le centre&lt;/b&gt; : adapters → ports, services → domaine.&lt;br&gt;• Les contrôleurs ne connaissent que des &lt;b&gt;ports&lt;/b&gt;, jamais les services.&lt;br&gt;• Deux &lt;b&gt;ACL&lt;/b&gt; entrantes : WebhookPayVia et AclSortiesFlash ; leur vocabulaire reste dans leur package.&lt;br&gt;• Les étapes 7 et 8 n'ont ajouté que des adapters, de la config et un port : &lt;b&gt;domaine inchangé&lt;/b&gt;." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=1;dashed=1;fontSize=10;fontColor=#334155;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1"><mxGeometry x="1200" y="670" width="440" height="130" as="geometry"/></mxCell>
