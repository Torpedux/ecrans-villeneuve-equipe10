        <mxCell id="sys_central" value="&lt;b style=&quot;font-size:15px;color:#1e3a8a;&quot;&gt;Système de Billetterie — Les Écrans de Villeneuve&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#1e40af;line-height:1.4;&quot;&gt;Permet la vente multicanale de places, la gestion des séances,&lt;br&gt;le contrôle d&#39;accès et les déclarations réglementaires.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1d4ed8;strokeWidth=2.5;shadow=1;align=center;verticalAlign=middle;spacing=12;" parent="1" vertex="1">
